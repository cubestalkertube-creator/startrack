{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Startrack",
  "version": "0.1.1",
  "identifier": "app.startrack.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Startrack",
        "width": 1200,
        "height": 760,
        "minWidth": 800,
        "minHeight": 500,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --autoplay-policy=no-user-gesture-required --host-resolver-rules=\"MAP 185-218-0-111.sslip.io 185.218.0.111, MAP turn.185-218-0-111.sslip.io 185.218.0.111\""
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"]
  }
}
