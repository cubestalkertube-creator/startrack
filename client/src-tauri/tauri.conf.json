{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Startrack",
  "version": "0.1.24",
  "identifier": "app.startrack.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE1MTM3RTAyMkYxOTAxRDQKUldUVUFSa3ZBbjRUcFdWdXlIeTAxSERpNFhLWFFPRVIyZzVQb2pRemlSejI3c2g3WWlZZnBZZ2YK",
      "endpoints": [
        "https://github.com/cubestalkertube-creator/startrack/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
